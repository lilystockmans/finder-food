<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1"
     creator="Motorcycle Route Planner"
     xmlns="http://www.topografix.com/GPX/1/1"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">

  <metadata>
    <name>Antwerp Kempen Forest Loop</name>
    <desc>2-hour motorcycle loop from Antwerp. 30 min E313 highway to Herentals, then 60 min twisty pine-forest roads through Kasterlee, Retie, Mol and Geel, 30 min highway return. Total approx 169 km. Forest roads rated by Detecht, Rever and BestBikingRoads communities for shade and twisties.</desc>
    <time>2026-05-24T14:00:00Z</time>
    <bounds minlat="51.1636" minlon="4.4350" maxlat="51.2640" maxlon="5.1200"/>
  </metadata>

  <wpt lat="51.1958" lon="4.4350">
    <name>START Antwerp Berchem</name>
    <desc>Take E313 east toward Hasselt. 52 km to exit.</desc>
    <sym>Flag, Green</sym>
  </wpt>

  <wpt lat="51.1796" lon="4.8361">
    <name>EXIT HIGHWAY Herentals jct 20</name>
    <desc>Leave E313 after approx 30 min. Take N13 north toward Kasterlee. Twisties begin!</desc>
    <sym>Flag, Blue</sym>
  </wpt>

  <wpt lat="51.2389" lon="4.9597">
    <name>Kasterlee Pine Forest</name>
    <desc>Deep Kempen pine village. Bear right on N19 east toward Retie. Rated top shaded road by Rever community.</desc>
    <sym>Waypoint</sym>
  </wpt>

  <wpt lat="51.2636" lon="5.0733">
    <name>Retie Northern Apex</name>
    <desc>Northern turnaround point. Head south via B-roads toward Mol through heathland and pines.</desc>
    <sym>Waypoint</sym>
  </wpt>

  <wpt lat="51.1905" lon="5.1150">
    <name>Mol Kempen Heart</name>
    <desc>Mol center. Take N71 or N18 west toward Geel. Dense forest on both sides.</desc>
    <sym>Waypoint</sym>
  </wpt>

  <wpt lat="51.1636" lon="4.9890">
    <name>Geel Return Point</name>
    <desc>Head south-west on N13 back to Herentals and the E313 motorway.</desc>
    <sym>Waypoint</sym>
  </wpt>

  <wpt lat="51.1958" lon="4.4350">
    <name>END Back in Antwerp</name>
    <desc>Total approx 2 h, 169 km. Highway 104 km, forest twisties 65 km.</desc>
    <sym>Flag, Red</sym>
  </wpt>

