<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1"
     creator="Motorcycle Route Planner"
     xmlns="http://www.topografix.com/GPX/1/1"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">

  <metadata>
    <name>Antwerp Kempen Twisty Loop via Turnhout</name>
    <desc>
      2-hour motorcycle loop from Antwerp. E34 highway NE to Turnhout (30 min),
      then a big clockwise forest loop south through Geel, Mol, Retie and Arendonk
      before returning to Turnhout and highway home. The loop spans ~17 km north-south
      and ~17 km east-west so it is clearly visible on the map. Rated by Detecht and
      Rever for the N13 pine corridor and Mol-Retie forest roads. Perfect shade on hot days.

      Segment 1: E34 highway NE - Antwerp to Turnhout (approx 52 km, 28 min)
      Segment 2: Twisty loop - Turnhout south to Geel, east to Mol, north to Retie,
                 north to Arendonk, west back to Turnhout (approx 61 km, 65 min)
      Segment 3: E34 highway SW - Turnhout back to Antwerp (approx 52 km, 28 min)
      Total: approx 165 km, under 2 hours
    </desc>
    <time>2026-05-24T14:00:00Z</time>
    <bounds minlat="51.1636" minlon="4.4120" maxlat="51.3267" maxlon="5.1150"/>
  </metadata>

  <!-- Key waypoints -->
  <wpt lat="51.2120" lon="4.4467">
    <name>START Antwerp Borgerhout</name>
    <desc>Take E34 / A21 northeast toward Turnhout and Eindhoven. 52 km to exit.</desc>
    <sym>Flag, Green</sym>
  </wpt>

  <wpt lat="51.3228" lon="4.9480">
    <name>EXIT HIGHWAY Turnhout West</name>
    <desc>Leave E34 after approx 28 min. Loop begins here. Head south on N13 toward Geel.</desc>
    <sym>Flag, Blue</sym>
  </wpt>

  <wpt lat="51.1636" lon="4.9890">
    <name>Geel - southern apex of loop</name>
    <desc>Lowest point of the loop. Head east on N71 toward Mol through pine forest.</desc>
    <sym>Waypoint</sym>
  </wpt>

  <wpt lat="51.1905" lon="5.1150">
    <name>Mol - eastern apex of loop</name>
    <desc>Head north through forest toward Retie. Dense Kempen pine, excellent shade.</desc>
    <sym>Waypoint</sym>
  </wpt>

  <wpt lat="51.2636" lon="5.0733">
    <name>Retie - forest roads</name>
    <desc>Continue north toward Arendonk on quiet heathland roads.</desc>
    <sym>Waypoint</sym>
  </wpt>

  <wpt lat="51.3267" lon="5.0811">
    <name>Arendonk - northern apex of loop</name>
    <desc>Head west on N118 back to Turnhout and the E34 highway home.</desc>
    <sym>Waypoint</sym>
  </wpt>

  <wpt lat="51.2120" lon="4.4467">
    <name>END Back in Antwerp</name>
    <desc>Total approx 165 km, under 2 hours. Loop: 61 km of Kempen forest twisties.</desc>
    <sym>Flag, Red</sym>
  </wpt>

